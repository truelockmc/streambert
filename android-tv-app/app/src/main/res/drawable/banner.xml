<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180dp TV launcher banner: app logo on the app's dark background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0B0B0F" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:drawable="@drawable/banner_logo"
        android:gravity="center" />
</layer-list>
